# Скопируй этот файл в .env и заполни своими значениями
# cp .env.example .env

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://finflow:finflow@localhost:5432/finflow

# Порт, на котором слушает сервер
PORT=3000

# Секреты для подписи JWT — сгенерируй случайные строки, например:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Время жизни токенов
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Домен фронтенда, которому разрешён доступ к API (CORS).
# Если фронтенд открывается как локальный файл (file://), браузер шлёт Origin: null —
# в этом случае оставь ALLOWED_ORIGIN пустым или укажи "*" на время разработки.
ALLOWED_ORIGIN=*

# Имя приложения, отображаемое в приложениях-аутентификаторах (Google Authenticator и т.п.)
TOTP_ISSUER=FinFlow

# "production" включает secure-cookies (требует HTTPS)
NODE_ENV=development

# ── Админ-панель ──
# Список email-ов админов через запятую. Пусто — админка отключена.
ADMIN_EMAILS=

# ── Отправка писем (код подтверждения почты) ──
# Если ничего не задано — код печатается в консоль сервера (удобно для локалки).
# Вариант A — Resend (проще всего): https://resend.com → API Keys
RESEND_API_KEY=
# Вариант B — любой SMTP (Yandex, Mail.ru, Gmail с app-паролем, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Отправитель (нужен подтверждённый домен у провайдера)
MAIL_FROM=FinFlow <no-reply@example.com>
