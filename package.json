{
  "name": "finflow-backend",
  "version": "1.0.0",
  "description": "Backend API для FinFlow — синхронизация транзакций, бюджетов и портфеля между устройствами",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "db:local": "node scripts/pg-dev.js",
    "gen:icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.11.5",
    "qrcode": "^1.5.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
